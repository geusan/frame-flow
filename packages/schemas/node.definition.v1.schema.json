{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/node.definition.v1.schema.json",
  "title": "Frameflow Node Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type_key",
    "contract_version",
    "lifecycle",
    "display",
    "ports",
    "config_schema",
    "binding_policy",
    "execution",
    "editor",
    "artifact_contract"
  ],
  "properties": {
    "schema_version": { "const": "node.definition.v1" },
    "type_key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+$" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "lifecycle": { "enum": ["ACTIVE", "DEPRECATED", "RETIRED", "BLOCKED"] },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "category", "icon"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "enum": ["Quick", "References", "Image", "Video", "Audio", "Utilities", "Advanced"] },
        "icon": { "type": "string", "minLength": 1 },
        "cost_label": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } }
      }
    },
    "config_schema": { "type": "object" },
    "binding_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_inputs"],
      "properties": { "workflow_inputs": { "enum": ["schema", "none"] } }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "executor", "revision", "provider", "model_alias"],
      "properties": {
        "kind": { "enum": ["source", "provider", "local", "human_gate", "composite"] },
        "executor": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model_alias": { "type": "string", "minLength": 1 },
        "model_families": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "enum": ["generic", "legacy"] } }
    },
    "artifact_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_type", "schema_id", "input_roles", "output_role"],
      "properties": {
        "primary_type": { "type": "string", "minLength": 1 },
        "schema_id": { "type": "string", "minLength": 1 },
        "input_roles": { "type": "object", "additionalProperties": { "type": "string" } },
        "output_role": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$" },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "default": false },
        "multiple": { "type": "boolean", "default": false }
      }
    }
  }
}
