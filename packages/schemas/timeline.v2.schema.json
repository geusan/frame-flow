{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/timeline.v2.schema.json",
  "title": "RichCaptionTimelineV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "width", "height", "fps", "duration_ms", "video_tracks", "audio_tracks", "caption_tracks", "effects"],
  "properties": {
    "version": { "const": "timeline.v2" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 1 },
    "video_tracks": { "type": "array", "items": { "$ref": "#/$defs/mediaTrack" } },
    "audio_tracks": { "type": "array", "items": { "$ref": "#/$defs/mediaTrack" } },
    "caption_tracks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/captionTrack" } },
    "effects": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "mediaTrack": {
      "type": "object",
      "required": ["id", "clips"],
      "properties": { "id": { "type": "string" }, "clips": { "type": "array", "items": { "type": "object" } } }
    },
    "captionTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "style", "clips", "document"],
      "properties": {
        "id": { "type": "string" },
        "style": { "type": "object" },
        "clips": { "type": "array", "items": { "type": "object" } },
        "document": { "$ref": "caption.document.v1.schema.json" }
      }
    }
  }
}
