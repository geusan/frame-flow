{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion.track.v1.schema.json",
  "title": "Motion Track V1",
  "type": "object",
  "required": ["schema_version", "extractor", "source", "summary", "frames"],
  "properties": {
    "schema_version": { "const": "motion.track.v1" },
    "extractor": {
      "type": "object",
      "required": ["name", "revision", "model", "min_confidence", "output_face_blendshapes"],
      "properties": {
        "name": { "type": "string" },
        "revision": { "type": "string" },
        "model": { "type": "string" },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "output_face_blendshapes": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["duration_ms", "width", "height", "sample_fps", "sample_width", "sample_height", "sha256"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sample_fps": { "type": "number", "minimum": 1, "maximum": 30 },
        "sample_width": { "type": "integer", "minimum": 1 },
        "sample_height": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["frame_count", "coverage"],
      "properties": {
        "frame_count": { "type": "integer", "minimum": 1 },
        "coverage": {
          "type": "object",
          "required": ["face", "pose", "left_hand", "right_hand"],
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp_ms", "face_landmarks", "pose_landmarks", "pose_world_landmarks", "left_hand_landmarks", "left_hand_world_landmarks", "right_hand_landmarks", "right_hand_world_landmarks", "face_blendshapes", "channels"],
        "properties": {
          "timestamp_ms": { "type": "integer", "minimum": 0 },
          "face_landmarks": { "$ref": "#/$defs/landmarks" },
          "pose_landmarks": { "$ref": "#/$defs/landmarks" },
          "pose_world_landmarks": { "$ref": "#/$defs/landmarks" },
          "left_hand_landmarks": { "$ref": "#/$defs/landmarks" },
          "left_hand_world_landmarks": { "$ref": "#/$defs/landmarks" },
          "right_hand_landmarks": { "$ref": "#/$defs/landmarks" },
          "right_hand_world_landmarks": { "$ref": "#/$defs/landmarks" },
          "face_blendshapes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "score"],
              "properties": {
                "name": { "type": "string" },
                "score": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          },
          "channels": { "type": "object", "additionalProperties": { "type": "number" } }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x", "y", "z"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" },
          "visibility": { "type": "number" },
          "presence": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
