{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/port-types.v1.schema.json",
  "title": "Frameflow Port Type Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "types"],
  "properties": {
    "schema_version": { "const": "port-types.v1" },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/portType" }
    }
  },
  "$defs": {
    "portType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "legacy_type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$"
        },
        "label": { "type": "string", "minLength": 1 },
        "legacy_type": { "type": "string", "minLength": 1 },
        "compatible_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$"
          },
          "default": []
        }
      }
    }
  }
}
