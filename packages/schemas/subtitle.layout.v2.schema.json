{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/subtitle.layout.v2.schema.json",
  "title": "RichCaptionLayoutV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "canvas", "frame", "align"],
  "properties": {
    "schema_version": { "const": "subtitle.layout.v2" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "schema_id"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schema_id": { "const": "caption.document.v1" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_artifact_id", "video_sha256", "width", "height", "preview_aspect_ratio"],
      "properties": {
        "video_artifact_id": { "type": "string", "minLength": 1 },
        "video_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "preview_aspect_ratio": { "enum": ["9:16", "16:9", "1:1"] }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "align": { "enum": ["left", "center", "right"] }
  }
}
