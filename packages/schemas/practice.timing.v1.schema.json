{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameflow.local/schemas/practice.timing.v1.schema.json",
  "title": "Practice audio timing v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fps", "voice_seconds", "phase_seconds", "question_seconds", "answer_seconds", "replay_start", "content_end", "ending_silence_seconds", "duration_seconds"],
  "properties": {
    "schema_version": {"const": "practice.timing.v1"},
    "fps": {"const": 30},
    "voice_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 15},
    "phase_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
    "question_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
    "answer_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
    "replay_start": {"type": "number", "minimum": 0},
    "content_end": {"type": "number", "exclusiveMinimum": 0},
    "ending_silence_seconds": {"type": "number", "minimum": 1.5, "maximum": 5},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}
  }
}
