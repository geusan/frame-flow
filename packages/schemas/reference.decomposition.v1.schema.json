{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference.decomposition.v1",
  "title": "Reference Decomposition v1",
  "type": "object",
  "required": ["schema_version", "source", "components", "speech", "audio", "visual", "artifacts", "quality", "provenance"],
  "properties": {
    "schema_version": { "const": "reference.decomposition.v1" },
    "source": {
      "type": "object",
      "required": ["duration_ms", "width", "height", "has_audio", "content_type"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "string" },
        "has_audio": { "type": "boolean" },
        "content_type": { "type": "string" }
      }
    },
    "components": {
      "type": "object",
      "required": ["speech", "music_separation", "shots", "actions", "onscreen_text", "sound_effects"],
      "additionalProperties": { "type": "string" }
    },
    "speech": {
      "type": "object",
      "required": ["language_code", "text", "segments"],
      "properties": {
        "language_code": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/timedText" }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": ["music_intervals", "sound_effects", "separation"],
      "properties": {
        "music_intervals": { "type": "array", "items": { "$ref": "#/$defs/timedEvent" } },
        "sound_effects": { "type": "array", "items": { "$ref": "#/$defs/timedEvent" } },
        "separation": { "type": "object" }
      }
    },
    "visual": {
      "type": "object",
      "required": ["shots", "actions", "text_tracks"],
      "properties": {
        "shots": { "type": "array", "items": { "$ref": "#/$defs/shot" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "text_tracks": { "type": "array", "items": { "$ref": "#/$defs/textTrack" } }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "quality": {
      "type": "object",
      "required": ["completeness", "warnings"],
      "properties": {
        "completeness": { "enum": ["complete", "partial"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": { "type": "object" }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "timedText": {
      "allOf": [
        { "$ref": "#/$defs/timeRange" },
        {
          "type": "object",
          "required": ["index", "text"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "timedEvent": {
      "allOf": [
        { "$ref": "#/$defs/timeRange" },
        {
          "type": "object",
          "required": ["label", "confidence"],
          "properties": {
            "label": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "shot": {
      "allOf": [
        { "$ref": "#/$defs/timeRange" },
        {
          "type": "object",
          "required": ["index", "transition_in", "scene_score"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "transition_in": { "type": "string" },
            "scene_score": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "action": {
      "allOf": [
        { "$ref": "#/$defs/timedEvent" },
        {
          "type": "object",
          "required": ["subject", "object", "evidence_shot_indices"],
          "properties": {
            "subject": { "type": "string" },
            "object": { "type": "string" },
            "evidence_shot_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
          }
        }
      ]
    },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "textTrack": {
      "allOf": [
        { "$ref": "#/$defs/timeRange" },
        {
          "type": "object",
          "required": ["track_id", "text", "kind", "confidence", "positions", "movement"],
          "properties": {
            "track_id": { "type": "string" },
            "text": { "type": "string" },
            "kind": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "positions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["timestamp_ms", "bbox"],
                "properties": {
                  "timestamp_ms": { "type": "integer", "minimum": 0 },
                  "bbox": { "$ref": "#/$defs/bbox" }
                }
              }
            },
            "movement": { "enum": ["static", "moving"] }
          }
        }
      ]
    }
  }
}
