    "duration_seconds": {"type": "integer", "minimum": 4, "maximum": 15, "default": 4, "title": "Generated duration (seconds)", "x-workflow-input": {"enabled": true, "type": "integer"}},
    "aspect_ratio": {"type": "string", "enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"], "default": "9:16", "title": "Aspect ratio", "x-workflow-input": {"enabled": true, "type": "enum"}},
    "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 3600, "default": 1200, "title": "Wait limit (seconds)"}
  }},
  "binding_policy": {"workflow_inputs": "schema"},
  "execution": {"kind": "provider", "executor": "reference-video-generation", "revision": "reference-video-generation.v1", "provider": "minimax", "model_alias": "minimax.video.h3", "model_families": ["minimax.video.h3"]},
  "editor": {"kind": "generic"},
