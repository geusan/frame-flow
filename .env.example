# Web
WEB_PORT=3001
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Docker Compose host ports
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8081
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API / PostgreSQL
DATABASE_URL=postgresql+psycopg://frameflow:frameflow@localhost:5432/frameflow
API_PUBLIC_BASE_URL=http://localhost:8000
APP_ENV=development
GENERATION_PROVIDER_MODE=live
REFERENCE_PROVIDER_MODE=live
VIDEO_DOWNLOADER_PROVIDER=yt-dlp
YT_DLP_EXECUTABLE=yt-dlp
YT_DLP_IMPERSONATE_TARGET=chrome
YT_DLP_IMPERSONATE_DOMAINS=tiktok.com
YT_DLP_IMPERSONATE_ATTEMPTS=6
SCENE_SEARCH_PROVIDER_MODE=live
FORMAT_PROVIDER_MODE=live
SUBTITLE_ALIGNMENT_MODE=live

# Object storage. Supported providers: memory, minio, r2, s3.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_AUTO_CREATE_BUCKETS=true
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_BUCKET_REFERENCE=project-reference-private
STORAGE_BUCKET_FORMATS=project-derived-formats
STORAGE_BUCKET_GENERATION=project-generation-assets
STORAGE_BUCKET_RENDERS=project-final-renders
STORAGE_ACCESS_KEY=frameflow
STORAGE_SECRET_KEY=frameflow-local-secret

# Cloudflare R2 example (use instead of the MinIO values above)
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_AUTO_CREATE_BUCKETS=false
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Workflow
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=frameflow-generation-v1
EXECUTION_BACKEND=local

# Google providers — required for live generation, format extraction, subtitles, and translation
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SPEECH_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VIDEO_OUTPUT_GCS_URI=
GOOGLE_VIDEO_TIMEOUT_SECONDS=900
GOOGLE_VIDEO_POLL_SECONDS=10

# OpenAI API provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
