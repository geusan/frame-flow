# Web
WEB_PORT=3001
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Docker Compose host ports
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8081
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API / PostgreSQL
DATABASE_URL=postgresql+psycopg://frameflow:frameflow@localhost:5432/frameflow
APP_ENV=development

# Object storage (MinIO locally, GCS in production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET_REFERENCE=project-reference-private
STORAGE_BUCKET_FORMATS=project-derived-formats
STORAGE_BUCKET_GENERATION=project-generation-assets
STORAGE_BUCKET_RENDERS=project-final-renders
STORAGE_ACCESS_KEY=frameflow
STORAGE_SECRET_KEY=frameflow-local-secret

# Workflow
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=frameflow-generation-v1
EXECUTION_BACKEND=demo

# Google providers — optional; local demo uses deterministic mock adapters
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
