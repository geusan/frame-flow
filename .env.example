# Web
WEB_PORT=3001
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Docker Compose host ports
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8081
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API / PostgreSQL
DATABASE_URL=postgresql+psycopg://frameflow:frameflow@localhost:5432/frameflow
API_PUBLIC_BASE_URL=http://localhost:8000
APP_ENV=development
GENERATION_PROVIDER_MODE=live
REFERENCE_PROVIDER_MODE=live
VIDEO_DOWNLOADER_PROVIDER=yt-dlp
YT_DLP_EXECUTABLE=yt-dlp
YT_DLP_IMPERSONATE_TARGET=chrome
YT_DLP_IMPERSONATE_DOMAINS=tiktok.com
YT_DLP_IMPERSONATE_ATTEMPTS=6
SCENE_SEARCH_PROVIDER_MODE=live
FORMAT_PROVIDER_MODE=live
SUBTITLE_ALIGNMENT_MODE=live
REFERENCE_ANALYSIS_MODE=live
REFERENCE_ANALYSIS_MODEL=google.text.fast
REFERENCE_AUDIO_SEPARATOR=demucs
DEMUCS_EXECUTABLE=demucs
DEMUCS_MODEL=htdemucs

# Object storage. Supported providers: memory, minio, r2, s3.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_AUTO_CREATE_BUCKETS=true
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_BUCKET_REFERENCE=project-reference-private
STORAGE_BUCKET_FORMATS=project-derived-formats
STORAGE_BUCKET_GENERATION=project-generation-assets
STORAGE_BUCKET_RENDERS=project-final-renders
STORAGE_ACCESS_KEY=frameflow
STORAGE_SECRET_KEY=frameflow-local-secret

# Cloudflare R2 example for replacing the entire artifact store (optional)
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_AUTO_CREATE_BUCKETS=false
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Cloudflare R2 LoRA training handoff (keeps the main artifact store on MinIO)
R2_ACCOUNT_ID=
R2_TRAINING_BUCKET=frameflow-lora-training
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_TRAINING_PREFIX=lora-training
R2_PRESIGNED_URL_TTL_SECONDS=3600

# Workflow
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=frameflow-generation-v1
EXECUTION_BACKEND=local

# Google providers — required for live generation, format extraction, subtitles, and translation
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SPEECH_LOCATION=us
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VIDEO_OUTPUT_GCS_URI=
GOOGLE_VIDEO_TIMEOUT_SECONDS=900
GOOGLE_VIDEO_POLL_SECONDS=10

# OpenAI API provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# xAI Grok Provider
XAI_API_KEY=

# Local subscription agents
# Host development uses the installed binaries and their local login/session.
CODEX_EXECUTABLE=codex
CODEX_HOME=
CLAUDE_CODE_EXECUTABLE=claude
CLAUDE_CODE_OAUTH_TOKEN=
# Compose persists `docker compose run --rm api codex login --device-auth` here.
FRAMEFLOW_CODEX_AUTH_DIR=./.local/codex
FRAMEFLOW_IMPORTS_DIR=./imports

# fal.ai model API provider
FAL_KEY=
